# Web service data is persistent only when this path is mounted as a volume.
RED_POTATO_RADAR_DATA_DIR=/data/red-potato-radar
RED_POTATO_RADAR_HOST=127.0.0.1
RED_POTATO_RADAR_PORT=8000
# Set this before binding beyond localhost; place it behind HTTPS reverse proxy.
RED_POTATO_RADAR_API_TOKEN=
RED_POTATO_RADAR_PUBLIC=false
RED_POTATO_RADAR_ALLOWED_ORIGINS=https://radar.example.com
